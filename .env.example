# ============================================================
# SmartPartMan — Template Konfigurasi Lingkungan
# ============================================================
# 1. Salin file ini menjadi .env
# 2. Isi nilai sesuai mesin Anda
# 3. JANGAN pernah commit file .env atau membagikannya
#
# File ini HANYA berisi placeholder aman, tanpa rahasia produksi.
# ============================================================

# --- Aplikasi ---
APP_NAME="SmartPartMan"
APP_ENV=local
APP_DEBUG=true
# APP_KEY: 64 karakter hex. Hasilkan dengan: php database/keygen.php
# Mengganti APP_KEY membuat rahasia terenkripsi di database tidak dapat dibuka.
APP_KEY=
APP_URL=http://localhost/smartpartman
APP_TIMEZONE=Asia/Jakarta

# --- Database MySQL/MariaDB ---
# XAMPP default: user root tanpa password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smartpartman_dev
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Database khusus pengujian (dibuat/di-reset oleh test; JANGAN arahkan ke produksi).
DB_TEST_NAME=smartpartman_test

# --- Binary CLI ---
# Path absolut PHP CLI (XAMPP: C:\xampp\php\php.exe).
PHP_CLI_PATH=C:\xampp\php\php.exe

# --- AI Prediksi Stok (Python lokal) ---
# Windows: py -3.12  |  Linux/macOS/CI: python3
PYTHON_PATH=py
PYTHON_ARGS=-3.12
# Untuk Linux/macOS/CI biasanya: PYTHON_PATH=python3 dan PYTHON_ARGS=

# --- Backup/Restore Database (Admin) ---
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
MYSQL_CLIENT_PATH=C:\xampp\mysql\bin\mysql.exe
BACKUP_MAX_MB=100

# --- Chatbot AI (Fase 8) ---
# API key LEBIH AMAN diisi lewat menu Admin > Pengaturan AI
# (disimpan terenkripsi di database). Kosongkan di sini bila tidak perlu.
# JANGAN menaruh API key di source code atau commit ke Git.
GEMINI_API_KEY=
# Opsional: ubah hanya untuk gateway internal/pengujian.
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT=25

# Catatan: token Fonnte (WhatsApp) TIDAK disimpan di .env.
# Token diisi oleh Admin melalui menu WhatsApp Gateway dan disimpan terenkripsi
# di database. Jangan menambahkan token sungguhan ke file contoh ini.
